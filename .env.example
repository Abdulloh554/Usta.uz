# ─── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081,https://usta-uz.onrender.com
# Shared with web/ — its auth route handlers relay sign-in and refresh for every
# web visitor and forward the visitor's address with this, so rate limits stay
# per person. Same value in web/.env.local. Empty = forwarded addresses ignored.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SHARED_SECRET=

# Node uses one core per process. 1 keeps a single process (right for a
# one-core container); 0 starts one worker per CPU; any other number is taken
# literally. Workers share nothing in memory — state is in Redis and MongoDB.
CLUSTER_WORKERS=1
# A drain that hangs holds a deploy open until the platform sends SIGKILL,
# which is the one exit that loses in-flight work.
SHUTDOWN_TIMEOUT_MS=15000
# Must be longer than the idle timeout of the proxy in front, or that proxy
# will occasionally reuse a connection the server is closing and return 502.
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=30000

# ─── database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://ustauz:ustauz@localhost:27017/ustauz?authSource=admin
# Per instance, so the total across replicas must stay under the cluster limit.
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5
# Leave on for a small database. Set to false once collections are large, and
# apply index changes with `npm run indexes:sync` as a release step instead.
MONGO_AUTO_INDEX=true

# ─── redis (cache, matching queue state, BullMQ) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ─── auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ─── SMS (Eskiz.uz primary, Play Mobile fallback) ──────────────────────────
SMS_PROVIDER=eskiz
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz/broker-api
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_MAX_ATTEMPTS=5

# ─── payments ──────────────────────────────────────────────────────────────
# 0 turns payments off (launch mode): accepting is free, no top-ups, no bonus.
# Set to 4999 once Payme / Click are connected.
ORDER_ACCEPT_FEE=0
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ─── media ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── push ──────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Web Push for the web app (browsers). Generate once:
#   npx web-push generate-vapid-keys
# Empty = browser push off; browser subscriptions are then skipped.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@ustamiz.uz

# ─── matching ──────────────────────────────────────────────────────────────
MATCH_OFFER_TIMEOUT_SECONDS=45
# A pro who closed the app still gets offers (by push) for this long.
MATCH_OFFLINE_GRACE_MINUTES=30
MATCH_MAX_CANDIDATES=20
MATCH_RADIUS_KM=15

# ─── limits, presence and caching ──────────────────────────────────────────
# Requests a minute under the API prefix, counted per signed-in account and
# only per IP when there is no token — Uzbek carriers put huge numbers of
# subscribers behind a few NAT addresses, so an IP-only budget is shared.
RATE_LIMIT_GLOBAL_MAX=300
# Set to `websocket` before running more than one instance: a polling client's
# requests can otherwise land on different replicas and its session breaks,
# which is what sticky sessions normally exist to prevent.
SOCKET_TRANSPORTS=websocket,polling
# How coarsely `lastSeenAt` is recorded. A phone reconnects constantly and an
# unthrottled write would be the heaviest write in the system.
PRESENCE_SEEN_THROTTLE_SECONDS=120
# The admin dashboard is thirty-odd full-collection counts behind one screen.
# 0 turns the cache off.
STATS_CACHE_SECONDS=30

# ─── observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
