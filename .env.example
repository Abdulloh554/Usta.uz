# ─── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,https://usta-uz.onrender.com

# ─── database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://ustauz:ustauz@localhost:27017/ustauz?authSource=admin

# ─── redis (cache, matching queue state, BullMQ) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ─── auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ─── SMS (Eskiz.uz primary, Play Mobile fallback) ──────────────────────────
SMS_PROVIDER=eskiz
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz/broker-api
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_MAX_ATTEMPTS=5

# ─── payments ──────────────────────────────────────────────────────────────
ORDER_ACCEPT_FEE=4999
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ─── media ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── push ──────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── matching ──────────────────────────────────────────────────────────────
MATCH_OFFER_TIMEOUT_SECONDS=45
MATCH_MAX_CANDIDATES=20
MATCH_RADIUS_KM=15

# ─── observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
